# Online backup of the Reflipped database (src/backup.ts), started daily by reflipped-backup.timer.
# Backups go to /var/lib/reflipped/backups, one folder per run; the newest BACKUP_KEEP are kept.
# Run one now with `systemctl start reflipped-backup`. Same sandbox as reflipped.service.

[Unit]
Description=Reflipped database backup
After=reflipped.service

[Service]
Type=oneshot
# The install script replaces this with the repo's location, as in reflipped.service.
WorkingDirectory=/reflipped
ExecStart=node out/backup.js
Environment=DATABASE_DIR=/var/lib/reflipped/database
Environment=BACKUP_DIR=/var/lib/reflipped/backups
Environment=BACKUP_KEEP=14
StateDirectory=reflipped
StateDirectoryMode=0700

# The same user name as reflipped.service, so both share the dynamic user and its state directory.
DynamicUser=yes
User=reflipped
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateNetwork=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A filtered call fails with EPERM instead of killing the process.
SystemCallErrorNumber=EPERM
