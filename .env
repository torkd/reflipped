CDN_DIR=".cdn"
LISTEN_HOST="0.0.0.0"
LISTEN_PORT="8000"
# admin UI and /api/* (admin login; ADMIN_AUTH=off removes it): keep it on localhost or a VPN address. ADMIN_PORT=0 disables it.
# Scripts reach /api/* with ADMIN_API_TOKEN (32+ characters): set it in the service environment, never here.
ADMIN_HOST="127.0.0.1"
ADMIN_PORT="8001"
