# Copy to .env (gitignored) and adjust. Paths are relative to this folder.

# The game assets (the same folder Reflipped's CDN_DIR points at).
CDN_DIR=../../.cdn

# Translation overlays built by npm run i18n:build (docs/i18n.md, "Overlay"); create the folder before the
# first `up`, owned by uid 1000. Here: a copy of the API host's folder.
CDN_OVERLAY_DIR=../../.cdn-overlay

# Where the edge (nginx) listens on the host: plain HTTP on HTTP_PORT; with TLS, HTTPS_PORT too.
# Behind a reverse proxy on this host, bind to 127.0.0.1 and keep TLS off (docker/README.md, "Behind
# an existing reverse proxy").
EDGE_BIND=0.0.0.0
HTTP_PORT=8080
HTTPS_PORT=8443

# Certificate volume name, shared by every flavour on this host.
CERT_VOLUME=reflipped-certs

# nginxinc/nginx-unprivileged and certbot tags.
NGINX_TAG=1.28-alpine
CERTBOT_TAG=v3.0.1

# --- TLS ---------------------------------------------------------------------------------------
# off (empty)  plain HTTP
# letsencrypt  Let's Encrypt for PUBLIC_HOST; host port 80 must be reachable from the internet
# selfsigned   a self-signed certificate (LAN tests, an upstream that accepts any certificate)
# custom       your own fullchain.pem + privkey.pem from CUSTOM_CERT_DIR
# For a direct public setup, set HTTP_PORT=80 and HTTPS_PORT=443.
TLS=
# Leave this line as it is: it starts the certificate service TLS needs.
COMPOSE_PROFILES=${TLS}
#PUBLIC_HOST=reflipped.example.com
# Extra names (or IPs) on the certificate, comma-separated.
#CERT_NAMES=
# letsencrypt: contact address, and 1 = the staging CA (untrusted certificate, no rate limits) for a first test.
#LE_EMAIL=you@example.com
#LE_STAGING=1
# selfsigned: validity in days.
#SELFSIGNED_DAYS=825
# custom: folder holding fullchain.pem and privkey.pem (relative to this folder).
#CUSTOM_CERT_DIR=../certs
