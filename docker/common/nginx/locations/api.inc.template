# The API proxied to Reflipped (flavours stack and api): game API, openapi, infodesk, /game pages.
# Included by both sites; rendered to /etc/nginx/conf.d/locations/api.inc by the image's entrypoint.

# Event schedule archives: Reflipped builds them into its data volume and serves them itself, on the game
# host even when the bulk assets come from elsewhere. ^~ wins over the asset location of assets.inc and
# the 404 of no-assets.inc.
location ^~ /patch/Live/2.0.0/schedule/ {
    proxy_pass ${REFLIPPED_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $reflipped_proto;
}

location / {
    proxy_pass ${REFLIPPED_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $reflipped_proto;
    proxy_pass_request_headers on;
}
