# Copy to .env (gitignored) and adjust. Paths are relative to this folder.

# The game assets (the same folder Reflipped's CDN_DIR points at). The proxy serves them from this
# folder too, or forwards /patch/Live/2.0.0/ to Reflipped.
CDN_DIR=../../.cdn

# Translation overlays built by npm run i18n:build (docs/i18n.md, "Overlay"); create the folder before the
# first `up`, owned by uid 1000.
CDN_OVERLAY_DIR=../../.cdn-overlay
# Send the en overlay to devices, once built: on (default) or off (still restores the originals once it was on).
I18N=on
# `docker compose --profile i18n run --rm i18n-build`: translations to build, lowest status that ships.
I18N_DIR=../../i18n
I18N_MIN_STATUS=machine

# Reflipped's game port on the host, for the proxy. Keep it on loopback.
API_BIND=127.0.0.1
API_PORT=8000

# Admin site (keep it on loopback; reach it over SSH or a VPN) and co-op socket on the host.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8001
COOP_BIND=0.0.0.0
COOP_PORT=18888

# Subnet of this stack's network. Requests from a proxy on the host arrive from its gateway, so
# Reflipped trusts X-Forwarded-For from it by default.
STACK_SUBNET=172.28.43.0/24
# With compose.network.yaml: the proxy's Docker network, and its subnet for TRUST_PROXY.
#PROXY_NETWORK=traefik
#TRUST_PROXY=172.18.0.0/16

# Data volume name, shared by every flavour on this host.
DATA_VOLUME=reflipped-data

# Backups (`docker compose run --rm backup`): host folder, writable by uid 1000, and how many to keep.
BACKUP_DIR=../backups
BACKUP_KEEP=14

# --- Server settings ---------------------------------------------------------------------------
# Passed into Reflipped's container; a line left commented out keeps Reflipped's default.
# Restart with `docker compose up -d` after changing them. See docker/README.md, "Server settings".
# A-only host name players reach co-op at (docker/README.md, "Co-op address and IPv6").
#COOP_PUBLIC_HOST=coop.reflipped.example.com
# The name the app shows, and where it downloads the game data from if not from this server.
#SERVER_NAME=Reflipped
#SHELL_CDN=https://cdn.example.com/patch/Live/2.0.0
# HTTPS pages for the app's Help and Community buttons.
#SERVER_SUPPORT_URL=https://your-community.example/help
#SERVER_COMMUNITY_URL=https://your-community.example/
# Bearer token (32+ characters) for /api/* on the admin port, for scripts and for creating the first
# admin: generate one with `openssl rand -hex 32`.
#ADMIN_API_TOKEN=
# Host names (comma-separated) you open the admin site by, besides IP addresses and localhost,
# e.g. a VPN name. Any other name gets a 403.
#ADMIN_ALLOWED_HOSTS=admin.vpn.example
# A web server on this host that serves the admin site over HTTPS: the address it arrives from (this
# setup's network gateway). Its X-Forwarded-Proto: https then counts, for the login cookie and warning.
#ADMIN_TRUST_PROXY=172.28.43.1
# closed = only the admin site creates portal accounts; all = every portal user may move their own clock.
#PORTAL_REGISTRATION=closed
#PORTAL_TIME_TRAVEL=all
# 0 = no rate limiting; new guest accounts per hour (0 = no limit).
#RATE_LIMIT=0
#NEW_ACCOUNTS_PER_HOUR=600
# QUEST_PERIOD_CHECK=off: event quests start any time. STAMINA=off: battles are free.
#QUEST_PERIOD_CHECK=off
#STAMINA=off
# Events: off = the historical server clock; managed = start in Managed reward mode (Settings page wins).
#EVENT_SCHEDULING=off
#REWARD_MANAGEMENT=managed
# SQLite cache and memory map in MiB, used until they are saved on the Settings page.
#SQLITE_CACHE_MB=16
#SQLITE_MMAP_MB=0
# info (default), warn, error or silent.
#LOG_LEVEL=info
