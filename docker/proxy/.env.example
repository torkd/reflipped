# Copy to .env (gitignored) and adjust. Paths are relative to this folder.

# The game assets (the same folder Reflipped's CDN_DIR points at). The proxy serves them from this
# folder too, or forwards /patch/Live/2.0.0/ to Reflipped.
CDN_DIR=../../.cdn

# Translation overlays built by npm run i18n:build (docs/i18n.md, "Overlay"); create the folder before the
# first `up`, owned by uid 1000.
CDN_OVERLAY_DIR=../../.cdn-overlay
# Send the en overlay to devices, once built: on (default) or off (still restores the originals once it was on).
I18N=on
# `docker compose --profile i18n run --rm i18n-build`: translations to build, lowest status that ships.
I18N_DIR=../../i18n
I18N_MIN_STATUS=machine

# Reflipped's game port on the host, for the proxy. Keep it on loopback.
API_BIND=127.0.0.1
API_PORT=8000

# Admin UI (no login) and co-op socket on the host.
ADMIN_BIND=127.0.0.1
ADMIN_PORT=8001
COOP_BIND=0.0.0.0
COOP_PORT=18888

# Subnet of this stack's network. Requests from a proxy on the host arrive from its gateway, so
# Reflipped trusts X-Forwarded-For from it by default.
STACK_SUBNET=172.28.43.0/24
# With compose.network.yaml: the proxy's Docker network, and its subnet for TRUST_PROXY.
#PROXY_NETWORK=traefik
#TRUST_PROXY=172.18.0.0/16

# Data volume name, shared by every flavour on this host.
DATA_VOLUME=reflipped-data

# Backups (`docker compose run --rm backup`): host folder, writable by uid 1000, and how many to keep.
BACKUP_DIR=../backups
BACKUP_KEEP=14
