{
  "name": "reflipped",
  "version": "1.0.1",
  "description": "A server reimplementation for the global version of World Flipper",
  "main": "server.ts",
  "scripts": {
    "build": "tsc && npm run css",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "css": "npx tailwindcss -i ./src/input.css -o ./web/public/tailwind.css",
    "css:watch": "npx tailwindcss -i ./src/input.css -o ./web/public/tailwind.css --watch --poll",
    "dev": "npm run build && node --env-file=.env --env-file-if-exists=.env.dev out/server.js",
    "cdn": "tsc && node --env-file=.env out/validate_cdn.js",
    "i18n:extract": "tsc && node --env-file-if-exists=.env out/i18n/extract.js",
    "i18n:build": "tsc && node --env-file-if-exists=.env out/i18n/build.js",
    "unzip": "tsc && node --env-file=.env out/unzip_cdn.js",
    "backup": "tsc && node --env-file=.env out/backup.js",
    "debug": "npm run css && npm run css:watch & npm run debug:ts-only",
    "i18n:glossary": "tsx src/lib/i18n/cli.ts glossary",
    "i18n:limits": "tsx src/lib/i18n/cli.ts limits",
    "i18n:check": "tsx src/lib/i18n/cli.ts check",
    "debug:ts-only": "tsnd --inspect -- src/server.ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^20.14.2",
    "@types/readline-sync": "^1.4.8",
    "@types/unzipper": "^0.10.9",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "ajv": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "cli-progress": "^3.12.0",
    "fastify": "^5.0.0",
    "msgpackr": "^1.12.1",
    "readline-sync": "^1.4.10",
    "tailwindcss": "^3.2.0",
    "unzipper": "^0.12.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
